# =============================================================
# NutriSense AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# =============================================================

# -------------------------------------------------------------
# Supabase Configuration (Required)
# Get these from: https://app.supabase.com > Project Settings > API
# -------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# -------------------------------------------------------------
# RevenueCat Configuration (Required for IAP)
# Get these from: https://app.revenuecat.com > Project > API Keys
# iOS key starts with "appl_", Android key starts with "goog_"
# Product ID: com.nutrisenseai.pro.lifetime
# Entitlement ID: pro
# Offering ID: default
# -------------------------------------------------------------
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_REVENUECAT_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_REVENUECAT_ANDROID_KEY

# -------------------------------------------------------------
# Edge Function API URL (Required for AI features)
# Set to your Supabase project URL — the app appends /functions/v1/
# e.g., https://YOUR_PROJECT_ID.supabase.co/functions/v1
# -------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://YOUR_PROJECT_ID.supabase.co/functions/v1

# -------------------------------------------------------------
# OpenAI API Key (Required — set as Supabase Edge Function Secret)
# This key is used SERVER-SIDE only in the Edge Functions.
# Set it via: supabase secrets set OPENAI_API_KEY=sk-...
# DO NOT prefix with EXPO_PUBLIC_ — it must never reach the client.
# -------------------------------------------------------------
# OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY  ← Server-side only

# -------------------------------------------------------------
# Open Food Facts API (Free — no key needed)
# -------------------------------------------------------------
EXPO_PUBLIC_OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org/api/v2

# -------------------------------------------------------------
# App Configuration
# -------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0
