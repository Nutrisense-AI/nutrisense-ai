        {
          "src": "/icon-scan-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "AI Chat",
      "short_name": "Chat",
      "description": "Chat with your AI Nutritionist",
      "url": "/?shortcut=chat",
      "icons": [
        {
          "src": "/icon-chat-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
